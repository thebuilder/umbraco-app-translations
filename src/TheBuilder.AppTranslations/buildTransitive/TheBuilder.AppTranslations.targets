<Project>
  <!-- The Umbraco.AI adapter, copied to a folder of its own beside the site's assemblies rather than
       referenced. Umbraco loads the references of every assembly in that folder at startup, and the
       adapter's include Umbraco.AI, which the site may not have. The assistant loads it from here
       once it has found a Umbraco.AI it supports. -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)../adapters/net10.0/TheBuilder.AppTranslations.UmbracoAI.dll"
          Link="TheBuilder.AppTranslations.UmbracoAI/TheBuilder.AppTranslations.UmbracoAI.dll"
          CopyToOutputDirectory="PreserveNewest"
          Visible="false"
          Pack="false" />
  </ItemGroup>
</Project>
