<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <StaticWebAssetBasePath>/</StaticWebAssetBasePath>
    <PackageId>TheBuilder.AppTranslations</PackageId>
    <Product>App Translations</Product>
    <Title>App Translations</Title>
    <!-- The local fallback. A release sets the version from its tag; see RELEASE.md. -->
    <Version>0.1.0</Version>
    <Authors>Daniel Schmidt</Authors>
    <Description>Manage application translation overrides from the Umbraco backoffice.</Description>
    <PackageTags>umbraco;umbraco-marketplace;translations;localization;next-intl;i18next;icu</PackageTags>
    <PackageIcon>icon.png</PackageIcon>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/thebuilder/umbraco-app-translations</PackageProjectUrl>
    <RepositoryUrl>https://github.com/thebuilder/umbraco-app-translations.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReleaseNotes>See https://github.com/thebuilder/umbraco-app-translations/releases for release notes.</PackageReleaseNotes>
    <BackofficeClientDirectory>$(MSBuildProjectDirectory)/Client</BackofficeClientDirectory>
    <BackofficeAssetsPattern>wwwroot/App_Plugins/TheBuilder.AppTranslations/**/*</BackofficeAssetsPattern>
    <BackofficeAssetsDirectory>$(MSBuildProjectDirectory)/wwwroot/App_Plugins/TheBuilder.AppTranslations</BackofficeAssetsDirectory>
    <BackofficeManifest>$(BackofficeAssetsDirectory)/umbraco-package.json</BackofficeManifest>
    <BackofficeEntryPoint>$(BackofficeAssetsDirectory)/translations.js</BackofficeEntryPoint>
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);IncludeCoreInPackage</TargetsForTfmSpecificBuildOutput>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);IncludeUmbracoAIAdapterInPackage</TargetsForTfmSpecificContentInPackage>
    <!-- The folder beside the site's assemblies that the Umbraco.AI adapter is copied to. The
         assistant loads it from there by this name, so the two have to agree. -->
    <UmbracoAIAdapterFolder>TheBuilder.AppTranslations.UmbracoAI</UmbracoAIAdapterFolder>
    <!-- NU5100 says an assembly outside lib/ is not referenced. The adapter is there on purpose. -->
    <NoWarn>$(NoWarn);NU5100</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- Core ships inside this package rather than as a package of its own, so it is private here
         and IncludeCoreInPackage puts its assembly in lib/. Without that, the nuspec lists a
         TheBuilder.AppTranslations.Core dependency that nuget.org does not have, and install fails.
         Core's one dependency, Microsoft.Extensions.Http, already comes with Umbraco.Cms.Web.Website. -->
    <ProjectReference Include="../TheBuilder.AppTranslations.Core/TheBuilder.AppTranslations.Core.csproj" PrivateAssets="all" />
    <!-- The Umbraco.AI adapter ships inside the package too, but not beside the other assemblies:
         Umbraco loads the references of every assembly in the site's folder at startup, and the
         adapter's include Umbraco.AI, which a site may not have. It is built, never referenced, and
         copied to a folder of its own; see that project, and AssistantChatRegistration. -->
    <ProjectReference Include="../TheBuilder.AppTranslations.UmbracoAI/TheBuilder.AppTranslations.UmbracoAI.csproj" PrivateAssets="all" ReferenceOutputAssembly="false" OutputItemType="UmbracoAIAdapterAssembly" />
    <!-- Core's dependency too, but Core is private to the package, so the package declares it. -->
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" />
    <PackageReference Include="Umbraco.Cms.Web.Website" />
    <PackageReference Include="Umbraco.Cms.Web.Common" />
    <PackageReference Include="Umbraco.Cms.Api.Common" />
    <PackageReference Include="Umbraco.Cms.Api.Management" />
    <PackageReference Include="MailKit" />
    <PackageReference Include="MessagePack" />
    <PackageReference Include="Microsoft.OpenApi" />
    <PackageReference Include="MimeKit" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
    <PackageReference Include="System.Security.Cryptography.Xml" />
  </ItemGroup>
  <ItemGroup>
    <Content Remove="Client\**" />
    <Content Remove="wwwroot/App_Plugins/TheBuilder.AppTranslations/**/*" />
    <None Include="Client\umbraco-package.json" Pack="false" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\icon.png" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
    <None Include="..\..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" />
    <!-- Copies the adapter into a site's output, for sites that install the package. -->
    <None Include="buildTransitive\TheBuilder.AppTranslations.targets" Pack="true" PackagePath="buildTransitive\" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="wwwroot/App_Plugins/TheBuilder.AppTranslations/" />
    <InternalsVisibleTo Include="TheBuilder.AppTranslations.Tests" />
  </ItemGroup>
  <Target Name="BuildBackofficeAssetsForPack" Condition="'$(_IsPacking)' == 'true' and '$(NoBuild)' != 'true'">
    <!-- The version goes in the manifest Umbraco reads, so the two cannot disagree. -->
    <Exec Command="corepack pnpm build" WorkingDirectory="$(BackofficeClientDirectory)" EnvironmentVariables="PACKAGE_VERSION=$(Version)" />
  </Target>
  <Target Name="RefreshBackofficeStaticWebAssets" BeforeTargets="ResolveProjectStaticWebAssets" DependsOnTargets="BuildBackofficeAssetsForPack">
    <ItemGroup><Content Include="$(BackofficeAssetsPattern)" /></ItemGroup>
  </Target>
  <Target Name="ValidateBackofficeAssetsForPack" BeforeTargets="IncludeStaticWebAssetsPackItems" Condition="'$(_IsPacking)' == 'true'">
    <Error Condition="!Exists('$(BackofficeManifest)')" Text="Cannot pack TheBuilder.AppTranslations because the backoffice manifest is missing." />
    <Error Condition="!Exists('$(BackofficeEntryPoint)')" Text="Cannot pack TheBuilder.AppTranslations because the backoffice entry point is missing." />
  </Target>
  <Target Name="IncludeCoreInPackage" DependsOnTargets="ResolveReferences">
    <ItemGroup>
      <BuildOutputInPackage Include="@(ReferenceCopyLocalPaths)" Condition="'%(ReferenceCopyLocalPaths.ReferenceSourceTarget)' == 'ProjectReference' and '%(ReferenceCopyLocalPaths.Extension)' == '.dll'" />
    </ItemGroup>
  </Target>
  <!-- The same copy the package's buildTransitive targets make, for the sample and the tests, which
       reference this project rather than the package. A copy item flows to referencing projects. -->
  <Target Name="CopyUmbracoAIAdapterToOutput" BeforeTargets="AssignTargetPaths" DependsOnTargets="ResolveProjectReferences">
    <ItemGroup>
      <None Include="@(UmbracoAIAdapterAssembly)" Link="$(UmbracoAIAdapterFolder)/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" Pack="false" />
    </ItemGroup>
  </Target>
  <Target Name="IncludeUmbracoAIAdapterInPackage" DependsOnTargets="ResolveProjectReferences">
    <ItemGroup>
      <TfmSpecificPackageFile Include="@(UmbracoAIAdapterAssembly)" PackagePath="adapters/$(TargetFramework)/" />
    </ItemGroup>
  </Target>
</Project>
